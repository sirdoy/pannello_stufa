# Firebase Configuration (Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Cloud Messaging (Push Notifications)
# Genera VAPID key: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key-here

# Firebase Admin SDK (Server-side push notifications)
# Scarica da: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Login session (first-party, users on the Pi DB — see lib/auth/sessionCookie.ts)
# Cookie encryption key (>= 32 chars): openssl rand -hex 32
SESSION_SECRET=use-openssl-rand-hex-32-to-generate

# HomeAssistant Proxy Configuration
# ==========================================
# Backend FastAPI (../backend) for all providers, rooms, registry and automations
# See docs/api/README.md for setup instructions
HA_API_URL=https://your-ha-proxy-host
HA_API_KEY=your-ha-api-key

# Backend admin credentials (server-side only)
# Used to obtain a backend JWT for API key management (/api/auth/api-keys, /api/auth/login)
HA_ADMIN_USER=your-ha-admin-user
HA_ADMIN_PASSWORD=your-ha-admin-password

# Backend WebSocket (browser-side, connects to ${NEXT_PUBLIC_WS_URL}/ws/live?api_key=...)
# The API key is exposed to the browser: use a dedicated backend API key
NEXT_PUBLIC_WS_URL=wss://your-ha-proxy-host
# (NEXT_PUBLIC_WS_API_KEY removed: the browser gets a 60s WS token from /api/ws-token)

# Cron Secret (Bearer / ?secret= for /api/scheduler/check, /api/notifications/cleanup,
# /api/admin/sync-changelog). Same value as the CRON_SECRET GitHub Actions secret.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Admin Secret (for /api/notifications/send and /api/notifications/trigger)
# Generate: openssl rand -hex 32
ADMIN_SECRET=your-admin-secret-here

# Admin User ID for scheduler notifications and manual /api/admin/sync-changelog
# Ottieni da Auth0 user.sub (es: auth0|xxx)
ADMIN_USER_ID=your-auth0-user-id

# Environment
NODE_ENV=development

# Local development / testing (never enable in production)
# ==========================================
# Skip Auth0 with a mock user: server side (lib/auth0.ts) and client side (ClientProviders)
BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false
# Automated test mode (disables WhatsNew modal); exposed to the client as NEXT_PUBLIC_TEST_MODE by next.config.ts
TEST_MODE=false
# Playwright e2e login user (tests/helpers/test-context.ts)
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Optional
# ==========================================
# Firebase RTDB-backed rate limiter instead of in-memory (lib/rateLimiter.ts)
USE_PERSISTENT_RATE_LIMITER=false
# Bundle analyzer on build (@next/bundle-analyzer)
ANALYZE=false
